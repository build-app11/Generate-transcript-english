const CAN_DL = true;

const $ = (s) => document.querySelector(s);
const fmt = (s) => { s = Math.max(0, Math.floor(s)); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };
const htmlEsc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const jsStr = (s) => s.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/\r?\n/g, ' ').replace(/<\/(script)/gi, '<\\/$1');
const jsTpl = (s) => s.replace(/\\/g, '\\\\').replace(/`/g, '\\`').replace(/\$\{/g, '\\${').replace(/<\/(script)/gi, '<\\/$1');

function extractId(s) {
  s = (s || '').trim();
  if (/^[\w-]{11}$/.test(s)) return s;
  const m = s.match(/(?:youtu\.be\/|[?&]v=|\/embed\/|\/shorts\/|\/live\/)([\w-]{11})/);
  return m ? m[1] : null;
}

function parse(raw) {
  const ent = [];
  raw.split(/\r?\n/).forEach((l) => {
    let m = l.match(/^\s*\[(\d{1,2}):(\d{2}):(\d{2})\]\s*(.*)$/);
    if (m) { ent.push([+m[1] * 3600 + +m[2] * 60 + +m[3], m[4].trim()]); return; }
    m = l.match(/^\s*\[(\d{1,3}):(\d{2})\]\s*(.*)$/);
    if (m) ent.push([+m[1] * 60 + +m[2], m[3].trim()]);
  });
  const tidy = (s) => s.replace(/"\s+(\S)/g, '"$1').replace(/\s+([.,?!])/g, '$1').replace(/ - /g, '-').replace(/\s+/g, ' ').trim();
  const out = [];
  let prev = -1, i = 0, skipped = 0, mism = 0;
  while (i < ent.length - 1) {
    if (ent[i][0] !== ent[i + 1][0]) { i += 1; skipped += 1; continue; }
    let t = ent[i][0];
    const en = tidy(ent[i][1]), ip = tidy(ent[i + 1][1]);
    i += 2;
    if (t <= prev) t = Math.round((prev + 0.6) * 100) / 100;
    prev = t;
    const a = en.split(' '), b = ip.split(' ');
    const d = { t, en, ip };
    if (a.length === b.length) d.w = a.map((x, k) => [x, b[k]]); else mism += 1;
    out.push(d);
  }
  if (i === ent.length - 1) skipped += 1;
  return { lines: out, skipped, mism, entries: ent.length };
}

function slug(s) {
  const x = s.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  return x || 'halaman';
}

function build() {
  const id = extractId($('#url').value);
  const title = $('#title').value.trim() || 'Shadowing';
  const raw = $('#raw').value.replace(/\r\n?/g, '\n').trim();
  return TEMPLATE
    .split('__VIDEO_ID__').join(id)
    .split('__JUDUL_HTML__').join(htmlEsc(title))
    .split('__JUDUL__').join(jsStr(title))
    .split('__TRANSKRIP__').join(jsTpl(raw));
}

let state = { id: null, parsed: null };
let timer = null;

function setPill(el, cls, text) {
  el.className = 'pill ' + cls;
  el.querySelector('span:last-child').innerHTML = text;
}

function refresh() {
  state.id = extractId($('#url').value);
  const hasUrl = $('#url').value.trim().length > 0;
  if (state.id) setPill($('#idPill'), 'ok', 'ID video <code>' + htmlEsc(state.id) + '</code>');
  else if (hasUrl) setPill($('#idPill'), 'bad', 'Link tidak dikenali. Pakai link youtu.be atau youtube.com/watch.');
  else setPill($('#idPill'), '', 'Belum ada link');

  const raw = $('#raw').value;
  const p = parse(raw);
  state.parsed = p;
  const w1 = $('#warn1'), w2 = $('#warn2'), pv = $('#preview');
  w1.hidden = true; w2.hidden = true;
  if (!raw.trim()) {
    setPill($('#rawPill'), '', 'Belum ada transkrip');
    pv.hidden = true;
  } else if (!p.lines.length) {
    setPill($('#rawPill'), 'bad', 'Formatnya belum terbaca. Pastikan tiap baris diawali [00:00:17] dan berpasangan.');
    pv.hidden = true;
  } else {
    const last = p.lines[p.lines.length - 1].t;
    setPill($('#rawPill'), 'ok', p.lines.length + ' baris terbaca, sampai sekitar ' + fmt(last + 5));
    if (p.skipped) { w1.hidden = false; w1.textContent = p.skipped + ' baris dilewati karena waktunya tidak berpasangan antara teks Inggris dan IPA.'; }
    if (p.mism) { w2.hidden = false; w2.textContent = p.mism + ' baris punya jumlah kata Inggris dan IPA yang berbeda, jadi fonetiknya tampil per baris, bukan per kata.'; }
    pv.hidden = false;
    const show = p.lines.slice(0, 5);
    pv.innerHTML = show.map((d) => {
      const body = d.w
        ? d.w.map(([a, b]) => '<span class="w"><b>' + htmlEsc(a) + '</b><i>' + htmlEsc(b) + '</i></span>').join('')
        : '<span class="w"><b>' + htmlEsc(d.en) + '</b><i>' + htmlEsc(d.ip) + '</i></span>';
      return '<div class="pl"><span class="tm">' + fmt(d.t) + '</span><div class="ws">' + body + '</div></div>';
    }).join('') + (p.lines.length > 5 ? '<div class="more">dan ' + (p.lines.length - 5) + ' baris lainnya</div>' : '');
  }
  const ready = !!state.id && p.lines.length > 0;
  $('#bDl').disabled = !ready;
  $('#bCopy').disabled = !ready;
  if ($('#dOut').open) $('#output').value = ready ? build() : '';
}
function schedule() { clearTimeout(timer); timer = setTimeout(refresh, 150); }

function toast(msg, bad) {
  const t = $('#toast');
  t.textContent = msg; t.className = 'toast' + (bad ? ' bad' : '');
  clearTimeout(toast._t);
  toast._t = setTimeout(() => { t.textContent = ''; }, 5000);
}

async function copyText(text, okMsg) {
  try {
    await navigator.clipboard.writeText(text);
    toast(okMsg);
  } catch (e) {
    const d = $('#dOut'); d.open = true;
    const o = $('#output');
    if (!o.value) o.value = text;
    o.focus(); o.select();
    toast('Salin otomatis ditolak. Kode sudah dipilih, tekan salin secara manual.', true);
  }
}

if (!CAN_DL) {
  $('#bDl').hidden = true;
  $('#bCopy').classList.add('primary');
}
$('#bDl').addEventListener('click', () => {
  try {
    const html = build();
    const blob = new Blob([html], { type: 'text/html;charset=utf-8' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = 'shadowing-' + slug($('#title').value) + '.html';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    toast('File diunduh: ' + a.download);
  } catch (e) { toast('Gagal mengunduh. Pakai tombol Salin kode.', true); }
});
$('#bCopy').addEventListener('click', () => copyText(build(), 'Kode disalin. Tempel ke file bernama index.html.'));
$('#bCopyIframe').addEventListener('click', () => copyText($('#iframeCode').textContent, 'Kode iframe disalin.'));
$('#dOut').addEventListener('toggle', () => { if ($('#dOut').open) $('#output').value = (state.id && state.parsed && state.parsed.lines.length) ? build() : ''; });

$('#bFile').addEventListener('click', () => $('#file').click());
$('#file').addEventListener('change', () => {
  const f = $('#file').files[0];
  if (!f) return;
  const r = new FileReader();
  r.onload = () => { $('#raw').value = String(r.result); refresh(); };
  r.readAsText(f);
});
$('#bSample').addEventListener('click', () => {
  $('#raw').value = SAMPLE;
  if (!$('#url').value.trim()) $('#url').value = 'https://youtu.be/52t241OQ7Ec';
  if (!$('#title').value.trim()) $('#title').value = 'Travel to the UK';
  refresh();
});
$('#bClear').addEventListener('click', () => { $('#raw').value = ''; refresh(); });
['#url', '#title', '#raw'].forEach((s) => $(s).addEventListener('input', schedule));
refresh();
</script>

